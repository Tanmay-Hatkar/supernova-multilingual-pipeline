GROQ_API_KEY=your-key-here

# Kept below 1000 deliberately. Several models on this provider enforce a
# per-minute output-token ceiling of 1000 and will reject any single
# request asking for more than that, regardless of actual usage — a
# structural rejection no retry can clear. Translations and judge JSON
# responses are both short, so this budget is ample. Raise it only after
# confirming every configured model can actually serve the larger value
# (run: python reliability.py).
MAX_OUTPUT_TOKENS=900

RATE_LIMIT_MAX_RETRIES=3
