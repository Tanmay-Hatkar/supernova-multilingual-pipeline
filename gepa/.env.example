# Your own key. Get one free at https://console.groq.com/keys
# This file is the template; .env itself is gitignored and never committed.
GROQ_API_KEY=your-key-here

# Kept below 1000 deliberately. Several models on this provider enforce a
# per-minute output-token ceiling of 1000 and will reject any single
# request asking for more than that, regardless of actual usage — a
# structural rejection no retry can clear. Translations and judge JSON
# responses are both short, so this budget is ample. Raise it only after
# confirming every configured model can actually serve the larger value
# (run: python run.py check).
MAX_OUTPUT_TOKENS=900

RATE_LIMIT_MAX_RETRIES=3

# Task-model response cache. An optimization run re-translates the same
# examples for every candidate prompt, and that repetition is most of its
# cost. Set TASK_CACHE=0 to translate everything fresh. The judge is never
# cached: its three runs at temperature 0.7 are sampled on purpose and
# their spread is how the pipeline measures its own noise floor.
TASK_CACHE=1
TASK_CACHE_DIR=.cache/task_model
